# Neon Postgres connection string (auto-set by the Vercel Neon integration)
DATABASE_URL=
# Optional: Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/refresh
CRON_SECRET=
# Optional: enables a simple password cookie gate when set
APP_PASSWORD=
# Optional: Jina Reader API key for the rendered-page fallback (works unauthenticated at a lower rate limit)
JINA_API_KEY=
