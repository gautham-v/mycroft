DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        "roles"         LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE Folder (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "title"    STRING,
        "position" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Source (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "feedUrl"   STRING,
        "title"     STRING,
        "url"       STRING,
        "kind"      STRING,
        "group"     STRING,
        "iconUrl"   STRING,
        "folder"    STRING,
        "position"  INT64,
        "pinnedAt"  TIMESTAMP,
        "isHidden"  INT64,
        "createdAt" TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SavedItem (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "sourceFeedUrl" STRING,
        "guid"          STRING,
        "url"           STRING,
        "title"         STRING,
        "summary"       STRING,
        "author"        STRING,
        "publishedAt"   TIMESTAMP,
        "thumbnailUrl"  STRING,
        "videoId"       STRING,
        "durationSec"   INT64,
        "audioUrl"      STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Settings (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "json" STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Integrations (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "webhookURL"    STRING,
        "readwiseToken"    ENCRYPTED STRING,
        "hasReadwiseToken" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Highlight (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "sourceFeedUrl"   STRING,
        "itemGuid"        STRING,
        "itemUrl"         STRING,
        "itemTitle"       STRING,
        "sourceTitle"     STRING,
        "itemAuthor"      STRING,
        "itemPublishedAt" TIMESTAMP,
        "text"            STRING,
        "prefix"          STRING,
        "suffix"          STRING,
        "note"            STRING,
        "color"           STRING,
        "createdAt"       TIMESTAMP,
        "updatedAt"       TIMESTAMP,
        "readwiseId"      INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE History (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "sourceFeedUrl"   STRING,
        "itemGuid"        STRING,
        "itemUrl"         STRING,
        "itemTitle"       STRING,
        "sourceTitle"     STRING,
        "sourceKind"      STRING,
        "itemAuthor"      STRING,
        "itemPublishedAt" TIMESTAMP,
        "thumbnailUrl"    STRING,
        "videoId"         STRING,
        "audioUrl"        STRING,
        "openedAt"        TIMESTAMP,
        "readAt"          TIMESTAMP,
        "positionSec"     INT64,
        "durationSec"     INT64,
        "progressPct"     INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
