<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud sync (CloudKit private database). CloudKit pushes tell the app about changes from other devices. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.gauthamv.openfeed</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Every build, local and released, uses Production, so a Mac built from this checkout and a
	     TestFlight iPhone see the same data. Schema changes must be deployed before they work anywhere. -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
